services:
  gitlab:
    image: "{{ gitlab_image }}"
    container_name: gitlab
    restart: always
    hostname: "{{ gitlab_external_host }}"

    environment:
      GITLAB_OMNIBUS_CONFIG: |
        external_url 'http://{{ gitlab_external_host }}{{ '' if gitlab_http_port | int == 80 else ':' ~ gitlab_http_port }}'

        registry_external_url 'http://{{ gitlab_external_host }}:{{ gitlab_registry_port }}'
        gitlab_rails['registry_enabled'] = true
        gitlab_rails['gitlab_shell_ssh_port'] = {{ gitlab_ssh_port }}

        puma['worker_processes'] = {{ gitlab_puma_workers }}
        puma['min_threads'] = 1
        puma['max_threads'] = 4
        sidekiq['concurrency'] = {{ gitlab_sidekiq_concurrency }}
        postgresql['shared_buffers'] = "{{ gitlab_postgres_shared_buffers }}"
        postgresql['max_connections'] = 100
        prometheus_monitoring['enable'] = false

        nginx['listen_port'] = {{ gitlab_http_port }}
        nginx['listen_https'] = false

    ports:
      - "{{ gitlab_http_port }}:{{ gitlab_http_port }}"
      - "{{ gitlab_ssh_port }}:22"
      - "{{ gitlab_registry_port }}:{{ gitlab_registry_port }}"

    volumes:
      - "{{ gitlab_data_dir }}/config:/etc/gitlab"
      - "{{ gitlab_data_dir }}/logs:/var/log/gitlab"
      - "{{ gitlab_data_dir }}/data:/var/opt/gitlab"

    shm_size: "{{ gitlab_shm_size }}"
