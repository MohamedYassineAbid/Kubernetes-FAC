# Namespace and the mysql Secret are created by the role (Secret via ExternalSecret)
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: mysql-config
  namespace: {{ mysql_namespace }}
data:
  my.cnf: |
    [mysqld]
    # MySQL 8.4 removed default_authentication_plugin; caching_sha2_password is the default.
    max_connections={{ mysql_max_connections }}
    innodb_buffer_pool_size={{ mysql_innodb_buffer_pool_size }}
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: mysql
  namespace: {{ mysql_namespace }}
spec:
  serviceName: mysql
  replicas: 1
  selector:
    matchLabels:
      app: mysql
  template:
    metadata:
      labels:
        app: mysql
        team: devops
    spec:
      containers:
        - name: mysql
          image: {{ mysql_image }}
          ports:
            - containerPort: 3306
              name: mysql
          env:
            - name: MYSQL_ROOT_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ mysql_secret_name }}
                  key: root-password
            - name: MYSQL_DATABASE
              valueFrom:
                secretKeyRef:
                  name: {{ mysql_secret_name }}
                  key: database
            - name: MYSQL_USER
              valueFrom:
                secretKeyRef:
                  name: {{ mysql_secret_name }}
                  key: user
            - name: MYSQL_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ mysql_secret_name }}
                  key: password
          resources: {{ mysql_resources | to_json }}
          volumeMounts:
            - name: mysql-data
              mountPath: /var/lib/mysql
            - name: mysql-config
              mountPath: /etc/mysql/conf.d
          livenessProbe:
            exec:
              command:
                - bash
                - -c
                - "mysqladmin ping -h localhost -uroot -p${MYSQL_ROOT_PASSWORD}"
            initialDelaySeconds: 60
            periodSeconds: 15
            timeoutSeconds: 10
            failureThreshold: 5
          readinessProbe:
            exec:
              command:
                - bash
                - -c
                - "mysqladmin ping -h localhost -uroot -p${MYSQL_ROOT_PASSWORD}"
            initialDelaySeconds: 60
            periodSeconds: 15
            timeoutSeconds: 10
            failureThreshold: 5
      volumes:
        - name: mysql-config
          configMap:
            name: mysql-config
  volumeClaimTemplates:
    - metadata:
        name: mysql-data
      spec:
        accessModes: ["ReadWriteOnce"]
        storageClassName: {{ storage_class_name }}
        resources:
          requests:
            storage: {{ mysql_storage_size }}
---
apiVersion: v1
kind: Service
metadata:
  name: mysql
  namespace: {{ mysql_namespace }}
spec:
  type: ClusterIP
  selector:
    app: mysql
  ports:
    - port: 3306
      targetPort: 3306
      name: mysql