apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{ es_name }}
  namespace: {{ es_namespace }}
spec:
  refreshInterval: {{ external_secrets_refresh_interval }}
  secretStoreRef:
    kind: ClusterSecretStore
    name: {{ secret_store_name }}
  target:
    name: {{ es_name }}
    creationPolicy: Owner
{% if es_static | default({}) | length > 0 %}
    # Non-secret values come from group_vars, merged into the same Secret
    template:
      engineVersion: v2
      mergePolicy: Merge
      data:
{% for k, v in es_static.items() %}
        {{ k }}: {{ v | string | to_json }}
{% endfor %}
{% endif %}
  data:
{% for key, prop in es_properties.items() %}
    - secretKey: {{ key }}
      remoteRef:
        key: {{ es_path }}
        property: {{ prop }}
{% endfor %}
