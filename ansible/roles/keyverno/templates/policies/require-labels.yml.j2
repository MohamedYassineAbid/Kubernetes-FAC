apiVersion: kyverno.io/v1
kind: ClusterPolicy
metadata:
  name: require-namespace-labels
spec:
  validationFailureAction: {{ kyverno_validation_failure_action }}
  rules:
    - name: check-namespace-labels
      match:
        any:
        - resources:
            kinds: [Namespace]
      exclude:
        any:
        - resources:
            names: {{ kyverno_excluded_namespaces | to_json }}
      validate:
        message: "Namespace labels {{ kyverno_required_labels | join(', ') }} are required."
        pattern:
          metadata:
            labels:
{% for label in kyverno_required_labels %}
              {{ label }}: "?*"
{% endfor %}