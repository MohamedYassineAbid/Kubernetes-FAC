apiVersion: v1
kind: Namespace
metadata:
  name: {{ traefik_namespace }}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ traefik_service_name }}
  namespace: {{ traefik_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: {{ traefik_service_name }}-role
rules:
  - apiGroups: [""]
    resources: ["services", "endpoints", "secrets", "nodes", "pods", "namespaces"]
    verbs: ["get", "list", "watch"]
  - apiGroups: ["discovery.k8s.io"]
    resources: ["endpointslices"]
    verbs: ["get", "list", "watch"]
  - apiGroups: ["networking.k8s.io"]
    resources: ["ingresses", "ingressclasses"]
    verbs: ["get", "list", "watch"]
  - apiGroups: ["networking.k8s.io"]
    resources: ["ingresses/status"]
    verbs: ["update"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: {{ traefik_service_name }}-binding
subjects:
  - kind: ServiceAccount
    name: {{ traefik_service_name }}
    namespace: {{ traefik_namespace }}
roleRef:
  kind: ClusterRole
  name: {{ traefik_service_name }}-role
  apiGroup: rbac.authorization.k8s.io
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ traefik_service_name }}
  namespace: {{ traefik_namespace }}
spec:
  replicas: {{ traefik_replicas }}
  selector:
    matchLabels:
      app: {{ traefik_service_name }}
  template:
    metadata:
      labels:
        app: {{ traefik_service_name }}
    spec:
      serviceAccountName: {{ traefik_service_name }}
      containers:
        - name: traefik
          image: {{ traefik_image }}
          args:
{% if traefik_dashboard_enabled %}
            # Dashboard only via the authenticated router in the dynamic config
            # (no --api.insecure, which would expose the API unauthenticated on :9000)
            - --api.dashboard=true
            - --providers.file.directory=/etc/traefik/dynamic
            - --providers.file.watch=true
{% endif %}
            - --providers.kubernetesingress=true
            - --entrypoints.web.address=:8000
            - --entrypoints.websecure.address=:8443
            - --entrypoints.traefik.address=:9000
{% if traefik_servers_transport_insecure_skip_verify | bool %}
            - --serversTransport.insecureSkipVerify=true
{% endif %}
{% if traefik_trusted_ips | length > 0 %}
            - --entryPoints.web.forwardedHeaders.trustedIPs={{ traefik_trusted_ips | join(',') }}
            - --entryPoints.websecure.forwardedHeaders.trustedIPs={{ traefik_trusted_ips | join(',') }}
{% endif %}
            - --accesslog=true
            - --ping=true
          ports:
            - name: web
              containerPort: 8000
            - name: websecure
              containerPort: 8443
            - name: traefik
              containerPort: 9000
          readinessProbe:
            httpGet:
              path: /ping
              port: traefik
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /ping
              port: traefik
            initialDelaySeconds: 10
            periodSeconds: 20
{% if traefik_dashboard_enabled %}
          volumeMounts:
            - name: dynamic-config
              mountPath: /etc/traefik/dynamic
              readOnly: true
            - name: dashboard-auth
              mountPath: /etc/traefik/auth
              readOnly: true
      volumes:
        - name: dynamic-config
          configMap:
            name: {{ traefik_service_name }}-dynamic
        - name: dashboard-auth
          secret:
            secretName: {{ traefik_service_name }}-dashboard-auth
{% endif %}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ traefik_service_name }}
  namespace: {{ traefik_namespace }}
spec:
  type: NodePort
  selector:
    app: {{ traefik_service_name }}
  ports:
{% if traefik_nodeport_http_enabled %}
    - name: web
      port: 80
      targetPort: web
      nodePort: {{ traefik_nodeport_http }}
{% endif %}
{% if traefik_nodeport_https_enabled %}
    - name: websecure
      port: 443
      targetPort: websecure
      nodePort: {{ traefik_nodeport_https }}
{% endif %}
---
{% if traefik_dashboard_enabled %}
apiVersion: v1
kind: Secret
metadata:
  name: {{ traefik_service_name }}-dashboard-auth
  namespace: {{ traefik_namespace }}
type: Opaque
stringData:
  users: "{{ traefik_dashboard_user }}:{{ traefik_dashboard_password | password_hash('bcrypt', salt=traefik_dashboard_auth_salt, rounds=12) }}"
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ traefik_service_name }}-dynamic
  namespace: {{ traefik_namespace }}
data:
  dashboard.yml: |
    http:
      routers:
        dashboard:
          rule: "Host(`{{ traefik_dashboard_host }}`)"
          entryPoints: [web, websecure]
          service: api@internal
          middlewares: [dashboard-auth]
      middlewares:
        dashboard-auth:
          basicAuth:
            usersFile: /etc/traefik/auth/users
            removeHeader: true
---
{% endif %}
apiVersion: networking.k8s.io/v1
kind: IngressClass
metadata:
  name: {{ traefik_ingress_class }}
spec:
  controller: traefik.io/ingress-controller
